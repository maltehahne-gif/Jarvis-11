# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/

# Tooling
.pytest_cache/
.ruff_cache/
.mypy_cache/
# hud/ has its own .gitignore for node_modules/dist; this only catches a
# stray root-level cache from running an npm tool outside hud/ by mistake.
/node_modules/

# Local-first runtime state. Principle 3: this data stays on the owner's
# machine and never belongs in the repository.
data/
*.db
*.db-wal
*.db-shm
